{
  "name": "termtone",
  "version": "0.1.0",
  "description": "Sound cues for Claude Code and any terminal command",
  "private": true,
  "type": "module",
  "bin": {
    "termtone": "dist/termtone.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepare": "npm run build",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "port-check": "npm run build && node port-check/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "hooks",
    "terminal",
    "sound",
    "notifications",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "5.7.3"
  }
}
